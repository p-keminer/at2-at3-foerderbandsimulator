  <Node _name="Formula Node" text="float64 dt,d,measured,noise,seed,ratio,missing,freq;&#10;int32 rawEcho,ready,valid,released,quality,parametersOK;&#10;missing=sqrt(-1.0); dt=p[0]; d=p[1];&#10;parametersOK=(dt&gt;0 &amp;&amp; dt&lt;=0.25 &amp;&amp; p[7]&gt;0 &amp;&amp; p[7]&lt;=50 &amp;&amp; p[8]&gt;=0 &amp;&amp; p[8]&lt;=50 &amp;&amp; p[9]&gt;=2 &amp;&amp; abs(p[5])&lt;100 &amp;&amp; p[6]&gt;=0 &amp;&amp; p[6]&lt;100 &amp;&amp; p[10]&gt;=1 &amp;&amp; p[10]&lt;=2147483646);&#10;if(s[0]==0){s[0]=1; s[15]=p[10];}&#10;if(parametersOK){&#10;  s[13]=s[13]+dt; s[12]=s[12]-dt; if(s[12]&lt;0){s[12]=0;}&#10;  seed=s[15]*16807; seed=seed-floor(seed/2147483647)*2147483647; s[15]=seed;&#10;  noise=p[6]*(2*seed/2147483647-1);&#10;  if(p[3]==0){s[9]=0; s[4]=0; s[5]=0; s[10]=0;}&#10;  else {s[9]=s[9]+dt;}&#10;  rawEcho=(p[2]&gt;0 &amp;&amp; d&gt;=50 &amp;&amp; d&lt;=400); ready=(p[3]&gt;0 &amp;&amp; s[9]&gt;=0.3);&#10;  released=(p[4]==0 &amp;&amp; s[6]&gt;0);&#10;  if(ready){&#10;    if(p[4]&gt;0){s[5]=s[5]+dt; s[11]=0;}&#10;    else {&#10;      if(released){&#10;        if(s[5]&gt;6){s[7]=1-s[7]; s[4]=0; s[12]=0.5; s[14]=12;}&#10;        else {if(s[5]&gt;=2){s[4]=1; s[11]=0;}&#10;          else {if(s[5]&gt;=0.7 &amp;&amp; s[5]&lt;=1.5){&#10;            if(s[4]==1){&#10;              if(rawEcho==0){s[8]=0; s[1]=0; s[2]=0; s[7]=0; s[4]=0; s[12]=0.5; s[14]=4;}&#10;              else {if(d&gt;50){s[3]=d; s[4]=2; s[11]=0;} else {s[4]=0;}}&#10;            } else {if(s[4]==2){&#10;              if(rawEcho &amp;&amp; s[3]&gt;=d){s[1]=s[3]; s[2]=d; s[8]=1; s[12]=0.5; s[14]=4;}&#10;              s[4]=0;&#10;            }}&#10;          }}&#10;        }&#10;        s[5]=0;&#10;      }&#10;      if(s[4]&gt;0){s[11]=s[11]+dt; if(s[11]&gt;p[9]){s[4]=0;}}&#10;    }&#10;  }&#10;  s[6]=(p[4]&gt;0);&#10;  quality=0; if(s[8]==0){quality=1;} if(d&lt;50 || d&gt;400){quality=2;} if(p[2]==0){quality=3;} if(ready==0){quality=4;} if(p[3]==0){quality=5;}&#10;  valid=(quality==0);&#10;  measured=50+floor((d+p[5]+noise-50)/p[7]+0.5)*p[7]; if(measured&lt;50){measured=50;} if(measured&gt;400){measured=400;}&#10;  y[0]=missing; y[1]=missing; y[2]=missing; y[3]=0;&#10;  if(valid){&#10;    ratio=(measured-50)/(s[1]-50); if(ratio&lt;0){ratio=0;} if(ratio&gt;1){ratio=1;}&#10;    y[0]=4+16*ratio; y[1]=50+350*ratio; y[2]=measured;&#10;    if(s[1]&gt;s[2]){s[10]=(measured&gt;=s[2] &amp;&amp; measured&lt;=s[1]);}&#10;    else {if(measured&lt;=s[1]){s[10]=1;} if(measured&gt;s[1]+p[8]){s[10]=0;}}&#10;    y[3]=s[10]; if(s[7]&gt;0){y[3]=1-y[3];}&#10;  }&#10;  freq=0; if(s[4]==1){freq=1;} if(s[4]==2){freq=2.5;} if(s[12]&gt;0){freq=s[14];}&#10;  y[4]=(rawEcho &amp;&amp; ready); y[5]=quality; y[6]=s[4]; y[7]=s[5]; y[8]=freq;&#10;} else {y[0]=missing; y[1]=missing; y[2]=missing; y[3]=0; y[4]=0; y[5]=9; y[6]=s[4]; y[7]=s[5]; y[8]=0;}&#10;y[9]=s[8]; y[10]=s[1]; y[11]=s[2]; y[12]=s[7]; y[13]=s[13];&#10;y[14]=0; if(p[3]&gt;0 &amp;&amp; y[8]&gt;0){ratio=s[13]*y[8]; y[14]=(ratio-floor(ratio)&lt;0.5);}" inputs="p:100.value,s:101.value,y:102.value" outputs="s:110.state,y:110.values" uid="110" uid_parent="root" />
