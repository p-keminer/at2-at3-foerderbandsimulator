  <Node _name="Formula Node" text="float64 dt,delta,target,step,span;&#10;int32 valid,start,manual,stop;&#10;dt=p[0]; valid=(dt&gt;0 &amp;&amp; dt&lt;=0.25 &amp;&amp; abs(p[1])&lt;1000000 &amp;&amp; abs(p[2])&lt;1000000 &amp;&amp; p[3]&gt;0 &amp;&amp; p[3]&lt;100000 &amp;&amp; p[4]&gt;=0 &amp;&amp; p[4]&lt;=3600 &amp;&amp; p[5]&gt;=1 &amp;&amp; p[5]&lt;=1000 &amp;&amp; p[11]&gt;0);&#10;if(s[0]==0){s[0]=1; s[1]=p[9]; s[2]=1;}&#10;start=(p[6]&gt;0 &amp;&amp; s[6]==0); manual=(p[8]&gt;0 &amp;&amp; s[7]==0); stop=(p[12]&gt;0 &amp;&amp; s[10]==0);&#10;if(valid){&#10;  s[8]=s[8]+dt;&#10;  if(start){s[1]=p[1]; s[2]=1; if(p[2]&lt;p[1]){s[2]=-1;} s[3]=1; s[4]=0; s[5]=0; s[9]=1;}&#10;  if(manual &amp;&amp; abs(p[9])&lt;1000000){s[1]=p[9]; s[3]=0;}&#10;  if(stop){s[3]=0;}&#10;  if(s[3]&gt;0 &amp;&amp; p[7]==0){&#10;    if(s[5]&gt;0){s[5]=s[5]-dt; if(s[5]&lt;0){s[5]=0;}}&#10;    else {&#10;      target=p[2]; if(s[9]==0){target=p[1];}&#10;      delta=target-s[1]; step=p[3]*dt;&#10;      if(p[10]==1){step=p[11];}&#10;      if(abs(delta)&lt;=step){&#10;        s[1]=target; s[5]=p[4];&#10;        if(p[10]==2){s[3]=0; s[4]=1;}&#10;        else {if(s[9]&gt;0){s[9]=0; s[2]=-s[2];} else {s[4]=s[4]+1; if(s[4]&gt;=floor(p[5])){s[3]=0;} else {s[9]=1; s[2]=-s[2];}}}&#10;      } else {if(delta&gt;0){s[1]=s[1]+step;} else {s[1]=s[1]-step;} if(p[10]==1){s[5]=p[4];}}&#10;    }&#10;  }&#10;}&#10;s[6]=(p[6]&gt;0); s[7]=(p[8]&gt;0); s[10]=(p[12]&gt;0);&#10;y[0]=s[1]; y[1]=s[3]; y[2]=s[4]; y[3]=s[8]; y[4]=valid;" inputs="p:100.value,s:101.value,y:102.value" outputs="s:110.state,y:110.values" uid="110" uid_parent="root" />
